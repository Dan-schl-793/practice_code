creating a video game character:

def character1(health, name, alive, ability):
    character_data = []

    character_data.append(health)
    character_data.append(name)
    character_data.append(alive)
    character_data.append(ability)

    return character_data

health_info = int(input("how much health is the character going to have?: "))
name_info = input("what is the characters name?: ")
alive_status_info = input("is the character alive?: ")
ability_info = input("what abilities does the character have?: ")

my_character = character1(
    health_info, name_info, alive_status_info, ability_info
)

print(my_character)
